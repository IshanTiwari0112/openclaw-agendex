{
  "plugins": {
    "load": {
      "paths": [
        "./extensions/agendex-guard"
      ]
    },
    "entries": {
      "agendex-guard": {
        "enabled": true,
        "config": {
          "guardUrl": "http://guard:8080",
          "defaultTask": "openclaw_social",
          "timeoutMs": 15000,
          "contextDefaults": {
            "agent_identity": "openclaw-bot"
          },
          "interceptOutbound": true,
          "outboundAction": "message.send"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "agendex_guard"
    ]
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [
        "+15555550123"
      ]
    }
  }
}
