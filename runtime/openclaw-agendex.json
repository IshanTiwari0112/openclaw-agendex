{
  "agents": {
    "defaults": {
      "workspace": "/data/openclaw/workspace",
      "model": {
        "primary": "openrouter/x-ai/grok-4.1-fast",
        "fallbacks": []
      },
      "models": {
        "openrouter/x-ai/grok-4.1-fast": {
          "alias": "Grok4.1Fast"
        }
      }
    }
  },
  "session": {
    "reset": {
      "mode": "idle",
      "idleMinutes": 43200
    },
    "resetByChannel": {
      "telegram": {
        "mode": "idle",
        "idleMinutes": 43200
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 7000,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "path": "/hooks"
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "telegram",
      "agendex-guard"
    ],
    "load": {
      "paths": [
        "/app/extensions/agendex-guard"
      ]
    },
    "entries": {
      "telegram": {
        "enabled": true
      },
      "agendex-guard": {
        "enabled": true,
        "config": {
          "guardUrl": "${AGENDEX_GUARD_URL}",
          "defaultTask": "openclaw_social",
          "timeoutMs": 15000,
          "contextDefaults": {
            "agent_identity": "openclaw-bot"
          },
          "interceptOutbound": true,
          "outboundAction": "message.send"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "agendex_guard",
      "web_search",
      "web_fetch"
    ],
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    }
  },
  "logging": {
    "consoleLevel": "info",
    "consoleStyle": "compact"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${OWNER_TG}"
      ]
    }
  }
}
