{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/x-ai/grok-4.1-fast",
        "fallbacks": []
      },
      "models": {
        "openrouter/x-ai/grok-4.1-fast": {
          "alias": "Grok4.1Fast"
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 7000,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_HOOKS_TOKEN}",
    "path": "/hooks"
  },
  "plugins": {
    "load": {
      "paths": [
        "./extensions/agendex-guard"
      ]
    },
    "entries": {
      "agendex-guard": {
        "enabled": true,
        "config": {
          "guardUrl": "${AGENDEX_GUARD_URL}",
          "defaultTask": "openclaw_social",
          "timeoutMs": 15000,
          "contextDefaults": {
            "agent_identity": "openclaw-bot"
          },
          "interceptOutbound": true,
          "outboundAction": "message.send"
        }
      }
    }
  },
  "tools": {
    "allow": [
      "agendex_guard"
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${OWNER_TG}"
      ]
    }
  }
}
